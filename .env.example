# Local dev database from docker-compose.yml. lib/db.ts falls back to this value if .env is missing.
DATABASE_URL=postgres://hylight:hylight@localhost:15432/hylight

# Optional: AI descriptions of uploaded photos (Amazon Bedrock). Leave the key empty to turn
# the feature off; uploads work the same, without a description. Restart the dev server after a change.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=eu-north-1
# Any vision model your key can use in that region.
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
